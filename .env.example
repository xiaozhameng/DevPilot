# ---- 生成模型（DeepSeek，OpenAI 兼容协议）----
DEVPILOT_API_KEY=sk-xxx
DEVPILOT_API_BASE=https://api.deepseek.com/v1
DEVPILOT_MODEL=openai/deepseek-v4-flash

# ---- 流水线刹车（防死循环的三个上限）----
# 每个都是"条件边成环"的刹车。没上限的环 = 无限烧钱。
DEVPILOT_MAX_CLARIFY=3       # 需求澄清最多追问几轮
DEVPILOT_MAX_CODEGEN=2       # 覆盖率不达标最多打回重写几次
DEVPILOT_COVERAGE_TARGET=80  # 覆盖率门禁（百分比）

# ---- 人工审批（HITL）----
# 等待窗口（秒），超时按拒绝处理。
# ⚠️ 必须与网关的 gateway.approval.wait-timeout-seconds 一致。
#    不一致会打架：网关更短的话，它会在内核还没放弃时就把任务当成"失联"重派，
#    于是同一个交付被跑两遍 —— 而这一切只因为一个配置项没对齐。
DEVPILOT_APPROVAL_TIMEOUT=1800

# ---- 沙箱 ----
DEVPILOT_WORKSPACE_DIR=var/workspaces
DEVPILOT_SANDBOX_TIMEOUT=120          # 单条命令超时（秒）
DEVPILOT_SANDBOX_OUTPUT_LIMIT=20000   # 命令输出保留上限（字符），超出截断

# ---- 服务层 ----
# 网关调内核时必须带上 X-Internal-Token: <这个值>
DEVPILOT_SERVE_HOST=127.0.0.1
DEVPILOT_SERVE_PORT=8078
DEVPILOT_INTERNAL_TOKEN=dev-local-token-change-me

# ---- 内核回调网关（用于任务状态回写）----
DEVPILOT_GATEWAY_BASE=http://127.0.0.1:8091
